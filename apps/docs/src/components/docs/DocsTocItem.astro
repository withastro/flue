---
interface Props {
	depth: number;
	slug: string;
	text: string;
}

const { depth, slug, text } = Astro.props;
---

<li class:list={['[&+&]:mt-2.5 leading-none', { 'pl-3.5': depth === 3 }]}>
	<a class="block text-sm text-zinc-500 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-50" href={`#${slug}`}>{text}</a>
</li>
