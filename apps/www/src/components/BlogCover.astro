---
// Blog hero cover. Two variants, selected per-post via frontmatter `cover`:
// - "shader" (default): paper-grid panel with a dithering "sphere" shader,
//   ported from the docs "why-flue" page (DocsCover, "workflows" variant).
//   Uses the existing www ambient-shader engine (`setupHomepageShaders`).
// - "logo": solid brand-blue panel with the white Flue mark centered.

interface Props {
	variant?: 'shader' | 'logo';
}

const { variant = 'shader' } = Astro.props;
---

{
	variant === 'logo' ? (
		<div class="mb-8 flex h-[200px] items-center justify-center overflow-hidden rounded-xl bg-[#007AFF] max-[760px]:mb-6 max-[760px]:h-[168px]" aria-hidden="true">
			<svg class="size-20" viewBox="0 0 108 108" fill="none" xmlns="http://www.w3.org/2000/svg">
				<rect width="18" height="18" transform="matrix(-1 0 0 1 72 18)" fill="white" />
				<rect width="18" height="18" transform="matrix(-1 0 0 1 54 72)" fill="white" />
				<rect width="18" height="18" transform="matrix(-1 0 0 1 54 36)" fill="white" />
				<rect width="18" height="18" transform="matrix(-1 0 0 1 72 54)" fill="white" />
			</svg>
		</div>
	) : (
		<div class="relative mb-8 flex h-[200px] items-center justify-center overflow-hidden rounded-sm border border-zinc-300 bg-zinc-200 text-zinc-500 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 max-[760px]:mb-6 max-[760px]:h-[168px]" aria-hidden="true">
			<svg class="absolute inset-0 size-full">
				<defs>
					<pattern id="blogCoverGrid" width="20" height="20" patternUnits="userSpaceOnUse">
						<path d="M20 0H0V20" fill="none" stroke="currentColor" stroke-opacity="0.72" stroke-width="0.8" stroke-dasharray="1 2" />
					</pattern>
				</defs>
				<rect width="100%" height="100%" fill="url(#blogCoverGrid)" />
			</svg>
			<div
				class="pattern-layer relative z-10 size-[144px] rounded-full max-[760px]:size-[128px]"
				style="--shadow-rgb: 59 130 246;"
				data-ambient-shader
				data-color-back="#00000000"
				data-color-front="#3b82f6"
				data-shape="sphere"
				data-type="4x4"
				data-size="2"
				data-scale="1.02"
				data-speed="0.18"
			/>
		</div>
	)
}

<script>
	import { setupHomepageShaders } from '../homepage-shaders';

	setupHomepageShaders();
</script>
