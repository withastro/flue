# Sentry — all optional. Without SENTRY_DSN the app runs unchanged with the
# Sentry SDK disabled; every capture and log call is a no-op.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=

# Tracing: 0 (the integration default) sends errors and logs only. This
# example's .env keeps 1.0 so every conversation produces a full trace.
SENTRY_TRACES_SAMPLE_RATE=1.0

# Content capture: with these on, traces carry prompts, model output, and
# tool arguments/results, and Sentry's AI Agents views reconstruct each run.
# Unset defers to the SDK's `dataCollection.genAI` policy (nothing configured
# = metadata only). On here so the example's traces are inspectable.
SENTRY_AI_RECORD_INPUTS=true
SENTRY_AI_RECORD_OUTPUTS=true

# The demo agents use Anthropic models.
ANTHROPIC_API_KEY=
